{
  "experiment_id": "exp001",
  "version": "neural-microgrid-v1",
  "period": [
    "2025-02-01",
    "2025-12-31"
  ],
  "time_alignment": "interval_end_natural_day",
  "billing": "full_original_plus_final_adjustment_plus_emergency",
  "efficiency": {
    "charge": 0.9,
    "discharge": 0.9
  },
  "initial_soc_kwh": 6000,
  "soc_bounds_kwh": [
    1200,
    10800
  ],
  "max_power_kw": 5000,
  "seed_list": [
    42,
    2026,
    3407
  ],
  "variants": [
    "mlp",
    "gru",
    "tcn",
    "gru_no_calendar",
    "gru_one_day"
  ],
  "selection_candidates": [
    "mlp",
    "gru",
    "tcn"
  ],
  "selection": "previous_seven_complete_days_total_dispatch_cost_seed_mean",
  "selection_initial_state": "common_yesterday_baseline_state_at_validation_start",
  "monthly_fit": "from_scratch_training_prefix_excludes_validation_week",
  "max_epochs": 60,
  "early_stopping_patience": 6,
  "batch_size": 64,
  "learning_rate": 0.001,
  "warmup": "January causal baseline initialized from attachment 1",
  "terminal_condition": "physical_bounds_only_no_daily_reset",
  "pv_interpolation": "linear_hourly_endpoints_with_last_observed_anchor",
  "forecast_issuance_hours": [
    0,
    6,
    12,
    18
  ],
  "target_order": [
    "load",
    "pv",
    "price",
    "pv_corrected"
  ],
  "architecture": {
    "independent_target_branches": 4,
    "mlp": {
      "hidden_units": [
        64,
        32
      ],
      "activation": "relu"
    },
    "gru": {
      "units": 32,
      "reset_after": true
    },
    "tcn": {
      "channels": [
        32,
        32,
        32,
        32
      ],
      "kernel_width": 3,
      "dilation_rates": [
        1,
        2,
        4,
        8
      ],
      "padding": "causal",
      "pooling": "global_average"
    },
    "per_target_head": {
      "hidden_units": 32,
      "activation": "relu",
      "output_units": 1,
      "output_activation": "linear",
      "shared_across_future_intervals": true
    },
    "history_hours": 168,
    "one_day_ablation_hours": 24,
    "forecast_intervals": 144,
    "dtype": "float32",
    "jit_compile": false,
    "optimizer": {
      "name": "Adam",
      "learning_rate": 0.001,
      "beta_1": 0.9,
      "beta_2": 0.999,
      "epsilon": 1e-07
    }
  }
}