# Regenerable experiment runs and intermediate datasets
experiments/**/runs/
# exp008 frozen deliverables are explicitly tracked by its commit-scope manifest.
# Keep local model weights, duplicate forecast archives and unselected run caches local.
/data/results/exp008/
/reports/experiments/exp008/**/*.xlsx.inspect.ndjson
# Regenerable artifact-tool full-cell inspection logs; checked summaries are committed.
data/results/exp004/*/*.xlsx.inspect.ndjson
# exp006 local build/export caches; portable report and checked evidence are tracked.
reports/experiments/exp006/app/dist/
reports/experiments/exp006/app/.data-app-offline/
reports/experiments/exp006/**/*.xlsx.inspect.ndjson
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md

